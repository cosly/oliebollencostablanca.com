{
  "name": "oliebollen-costa-blanca",
  "version": "1.0.0",
  "description": "Oliebollen bestelsite voor Costa Blanca",
  "scripts": {
    "dev": "wrangler dev --port 8080",
    "dev:pages": "wrangler pages dev . --port 8080 --binding ENVIRONMENT=development",
    "deploy": "wrangler pages deploy . --project-name oliebollencostablanca-com",
    "db:create": "wrangler d1 create oliebollen-db",
    "db:init": "wrangler d1 execute oliebollen-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute oliebollen-db --local --file=./schema.sql"
  },
  "keywords": [
    "oliebollen",
    "costa-blanca",
    "cloudflare"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "nodemailer": "^7.0.11",
    "wrangler": "^4.51.0"
  }
}
